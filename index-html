    function countWords(str) {
      const cleaned = str.trim().replace(/[.,!?;:()"]/g, " ").trim();
      if (!cleaned) return 0;
      return cleaned.split(/\s+/).length;
    }

    function updateWordCounter(inputId, badgeId, maxWords) {
      const val = document.getElementById(inputId).value;
      const wc = countWords(val);
      const badge = document.getElementById(badgeId);
      badge.textContent = `${wc}/${maxWords} words`;
      if (wc > maxWords) {
        badge.className = "text-xs font-bold px-2.5 py-0.5 rounded-lg bg-red-600 text-white shadow-sm whitespace-nowrap transition";
      } else if (wc > 0) {
        badge.className = "text-xs font-bold px-2.5 py-0.5 rounded-lg bg-emerald-100 text-emerald-800 whitespace-nowrap transition";
      } else {
        badge.className = "text-xs font-bold px-2.5 py-0.5 rounded-lg bg-stone-200 text-stone-600 whitespace-nowrap transition";
      }
    }

