    function submitPeerPost() {
      const text = document.getElementById("peerPostText").value.trim();
      const topic = document.getElementById("postTopicSelect").value;
      const authorName = (window.appState.currentStudent.name || "").trim();
      const authorClass = (window.appState.currentStudent.studentClass || "").trim();

      if (!authorName || !authorClass) {
        showToast("Please enter your Full Name and Class first!", "⚠️");
        openStudentProfileModal();
        return;
      }

      if (!text && !currentAudioDataUrl) {
        showToast("Please write your answers or record/attach audio first!", "⚠️");
        return;
      }

      const hasRealAudioFile = currentAudioDataUrl && currentAudioDataUrl.startsWith("data:audio");

      const newPost = {
        id: "post_" + Date.now(),
        createdAtMs: Date.now(),
        author: authorName,
        studentClass: authorClass,
        topic,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        text: text || "(Voice interview recording submitted)",
        simulatedSpeechText: text || "Hello! I lived in Mesopotamia and grew wheat and barley.",
        audioUrl: hasRealAudioFile ? currentAudioDataUrl : null,
        voiceDuration: hasRealAudioFile ? currentAudioLabel : "Spoken Audio (TTS)",
        likes: 0,
        comments: []
      };

      window.appState.peerPosts.unshift(newPost);
      try {
        localStorage.setItem(POSTS_STORAGE_KEY, JSON.stringify(window.appState.peerPosts));
      } catch (e) {}

      const rec = ensureCurrentStudentRecord();
      rec.s5.done = true;
      rec.s5.posts = (rec.s5.posts || 0) + 1;
      saveStudentRecordEverywhere(rec);

      if (typeof window.syncPeerPostToCloud === 'function') {
        window.syncPeerPostToCloud(newPost);
      }

      document.getElementById("peerPostText").value = "";
      updatePeerPostWordCount();
      clearRecording();
      renderPeerFeed();
      refreshGlobalProgress();
      showToast("Posted your written & voice entry to the Class Wall!", "🎉");
    }

    function playTextToSpeechAudio(author, text) {
      if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        utter.lang = "en-GB";
        utter.rate = 0.92;
        window.speechSynthesis.speak(utter);
        showToast(`🔊 Playing ${author}'s spoken response...`, "🎧");
      } else {
        showToast(`🎧 Playing voice note from ${author}`, "🔊");
