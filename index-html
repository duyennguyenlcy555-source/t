    let mediaRecorder = null;
    let recordedChunks = [];
    let currentAudioDataUrl = null;
    let currentAudioLabel = "Voice Recording";
    let recordSeconds = 0;
    let recordTimerInterval = null;

    function updatePeerPostWordCount() {
      const wc = countWords(document.getElementById("peerPostText").value);
      document.getElementById("peerPostWordCount").textContent = `${wc} words`;
    }

    function getSupportedAudioMimeType() {
      if (typeof MediaRecorder === "undefined" || typeof MediaRecorder.isTypeSupported !== "function") {
        return "";
      }
      const candidates = [
        "audio/webm;codecs=opus",
        "audio/webm",
        "audio/mp4",
        "audio/ogg;codecs=opus",
        "audio/ogg"
      ];
      for (const type of candidates) {
        if (MediaRecorder.isTypeSupported(type)) return type;
      }
      return "";
    }

    async function startRecording() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        document.getElementById("recorderStatus").innerHTML =
          `<span class="text-amber-900 font-medium">⚠️ Browser microphone API is unavailable in this window. Use <strong>Upload Audio File (.mp3/.m4a/.wav)</strong> or <strong>Generate Spoken Audio (TTS)</strong> right next to it!</span>`;
        showToast("Use Upload Audio File or Generate Spoken Audio (TTS)!", "🔊");
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        recordedChunks = [];
        const mimeType = getSupportedAudioMimeType();
        mediaRecorder = mimeType ? new MediaRecorder(stream, { mimeType }) : new MediaRecorder(stream);

        mediaRecorder.ondataavailable = e => {
          if (e.data && e.data.size > 0) recordedChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          const blobType = mediaRecorder.mimeType || mimeType || "audio/webm";
          const blob = new Blob(recordedChunks, { type: blobType });
          const reader = new FileReader();
          reader.onloadend = () => {
            currentAudioDataUrl = reader.result;
            currentAudioLabel = `Recorded Voice (0:${String(Math.max(1, recordSeconds)).padStart(2, "0")})`;
            const preview = document.getElementById("recordedAudioPreview");
            preview.src = currentAudioDataUrl;
            document.getElementById("audioPreviewBox").classList.remove("hidden");
            document.getElementById("recorderStatus").textContent = `✅ ${currentAudioLabel} ready! Play it back below or click Post to Class Wall.`;
            saveCurrentDraftState();
          };
          reader.readAsDataURL(blob);
          stream.getTracks().forEach(t => t.stop());
        };

        mediaRecorder.start(250);
        recordSeconds = 0;
        document.getElementById("recordTimer").textContent = "0s";
        document.getElementById("btnStartRecord").classList.add("hidden");
        document.getElementById("btnStopRecord").classList.remove("hidden");
        document.getElementById("recorderStatus").textContent = "🔴 Recording... Speak your Neolithic farmer answers clearly!";

        recordTimerInterval = setInterval(() => {
          recordSeconds++;
          document.getElementById("recordTimer").textContent = `${recordSeconds}s`;
          if (recordSeconds >= 60) stopRecording();
        }, 1000);
      } catch (err) {
        document.getElementById("recorderStatus").innerHTML =
          `<span class="text-amber-900 font-medium">⚠️ Microphone access was blocked by browser/iframe permissions. Click <strong>Upload Audio File (.mp3/.m4a/.wav)</strong> or <strong>Generate Spoken Audio (TTS)</strong>!</span>`;
        showToast("Mic blocked — use Upload Audio File or Generate Spoken Audio (TTS)!", "🔊");
      }
    }

    function stopRecording() {
      clearInterval(recordTimerInterval);
      document.getElementById("btnStopRecord").classList.add("hidden");
      document.getElementById("btnStartRecord").classList.remove("hidden");
      if (mediaRecorder && mediaRecorder.state !== "inactive") {
        mediaRecorder.stop();
      }
    }

    function handleAudioFileUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      if (file.size > 4 * 1024 * 1024) {
        showToast("Please choose an audio file smaller than 4 MB.", "⚠️");
        return;
      }
      const reader = new FileReader();
      reader.onloadend = () => {
        currentAudioDataUrl = reader.result;
