  <!-- ==================== REAL-TIME CLOUD SYNC MODULE ==================== -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    const appId = typeof __app_id !== 'undefined' ? __app_id : 'farming-changes-the-world';
    let db = null;
    let auth = null;
    let cloudReady = false;

    async function initCloudSync() {
      const statusEl = document.getElementById("syncStatusIndicator");
      try {
        if (typeof __firebase_config === 'undefined' || !__firebase_config) {
          if (statusEl) statusEl.textContent = "Ready (local browser persistence active)";
          return;
        }
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        db = getFirestore(app);
        auth = getAuth(app);

        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }

        if (!auth.currentUser) return;
        cloudReady = true;
        if (statusEl) statusEl.textContent = "🟢 Connected — Live Cloud Sync & Local Auto-Save Active";

        const progressCol = collection(db, 'artifacts', appId, 'public', 'data', 'student_progress');
        onSnapshot(progressCol, (snapshot) => {
          snapshot.forEach((docSnap) => {
            const data = docSnap.data();
            if (data && data.name && data.studentClass) {
              const key = window.getStudentNormalizedKey(data.studentClass, data.name);
              window.appState.roster[key] = data;
              try {
                localStorage.setItem(key, JSON.stringify(data));
              } catch (e) {}
            }
          });
          if (typeof window.refreshGlobalProgress === 'function') window.refreshGlobalProgress();
          if (window.isTeacherMode && typeof window.renderTeacherDashboard === 'function') {
            window.renderTeacherDashboard();
          }
        }, (err) => {
          console.warn("Progress sync listener error:", err);
        });

        const postsCol = collection(db, 'artifacts', appId, 'public', 'data', 'peer_posts');
        onSnapshot(postsCol, (snapshot) => {
          const remotePosts = [];
          snapshot.forEach((docSnap) => {
            remotePosts.push(docSnap.data());
          });
          remotePosts.sort((a, b) => (b.createdAtMs || 0) - (a.createdAtMs || 0));
          window.appState.peerPosts = remotePosts;
          try {
            localStorage.setItem("fcw_peer_posts_all", JSON.stringify(remotePosts));
          } catch (e) {}
          if (typeof window.renderPeerFeed === 'function') window.renderPeerFeed();
          if (window.isTeacherMode && typeof window.renderTeacherDashboard === 'function') {
            window.renderTeacherDashboard();
          }
        }, (err) => {
          console.warn("Peer board sync listener error:", err);
        });
      } catch (err) {
        console.warn("Cloud sync fallback:", err);
        if (statusEl) statusEl.textContent = "Local browser persistence active";
      }
    }

    window.syncStudentRecordToCloud = async function(record) {
      if (!cloudReady || !db || !auth?.currentUser || !record?.name || !record?.studentClass) return;
      try {
        const safeId = encodeURIComponent(window.getStudentNormalizedKey(record.studentClass, record.name));
        const ref = doc(db, 'artifacts', appId, 'public', 'data', 'student_progress', safeId);
        await setDoc(ref, record, { merge: true });
      } catch (e) {
        console.warn("Failed to sync student progress:", e);
      }
    };

    window.syncPeerPostToCloud = async function(post) {
      if (!cloudReady || !db || !auth?.currentUser || !post?.id) return;
      try {
        const ref = doc(db, 'artifacts', appId, 'public', 'data', 'peer_posts', post.id);
        await setDoc(ref, post, { merge: true });
      } catch (e) {
        console.warn("Failed to sync peer post:", e);
      }
    };

    initCloudSync();
  </script>

