    function downloadStudentSubmissionFile() {
      const rec = ensureCurrentStudentRecord();
      if (!rec.name || !rec.studentClass) {
        showToast("Please enter your Full Name and Class first!", "⚠️");
        return;
      }
      rec.draftInputs = collectAllFormInputs();
      const myPosts = window.appState.peerPosts.filter(
        p => p.author === rec.name && p.studentClass === rec.studentClass
      );
      const payload = {
        type: "FCW_STUDENT_SUBMISSION",
        exportedAt: new Date().toISOString(),
        studentRecord: rec,
        peerPosts: myPosts
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      const safeName = `${rec.name}_${rec.studentClass}`.replace(/[^a-zA-Z0-9_-]/g, "_");
      a.download = `Submission_${safeName}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("Student submission file downloaded!", "📥");
    }

    function importStudentSubmissionJSON(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const data = JSON.parse(e.target.result);
          const rec = data.studentRecord || (data.name && data.studentClass ? data : null);
          if (!rec || !rec.name || !rec.studentClass) {
            showToast("Invalid student submission file.", "⚠️");
            return;
          }
          saveStudentRecordEverywhere(rec);

          if (Array.isArray(data.peerPosts)) {
            data.peerPosts.forEach(p => {
              if (p.id && !window.appState.peerPosts.some(existing => existing.id === p.id)) {
                window.appState.peerPosts.push(p);
              }
            });
            try {
              localStorage.setItem(POSTS_STORAGE_KEY, JSON.stringify(window.appState.peerPosts));
            } catch (err) {}
          }
          renderPeerFeed();
          renderTeacherDashboard();
          showToast(`Imported submission from ${rec.name} (${rec.studentClass})!`, "✅");
        } catch (err) {
          showToast("Could not read JSON file.", "⚠️");
        }
      };
      reader.readAsText(file);
      event.target.value = "";
    }

