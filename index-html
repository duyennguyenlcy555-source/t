    function checkStation2() {
      let score = 0;
      let wordLimitErrors = 0;
      const mistakes = [];
      const responses = {};

      FACT_FILE_ITEMS.forEach(item => {
        const raw = document.getElementById(`inp_${item.id}`).value.trim();
        const lower = raw.toLowerCase();
        const wc = countWords(raw);
        const fb = document.getElementById(`fb_${item.id}`);
        fb.classList.remove("hidden");
        responses[item.label] = raw ? `${raw} (${wc}/${item.maxWords}w)` : "(blank)";

        if (!raw) {
          mistakes.push(`${item.label}: left blank`);
          fb.className = "text-xs p-2.5 rounded-xl mt-1 bg-amber-100 text-amber-950 font-medium";
          fb.innerHTML = `⚠️ This field is empty. Check Part A and write up to ${item.maxWords} words.`;
          return;
        }

        if (wc > item.maxWords) {
          wordLimitErrors++;
          mistakes.push(`${item.label}: exceeded word limit (${wc}/${item.maxWords} words)`);
          fb.className = "text-xs p-2.5 rounded-xl mt-1 bg-red-100 text-red-950 font-medium";
          fb.innerHTML = `❌ <strong>Word-Limit Error:</strong> You wrote <strong>${wc} words</strong> (maximum allowed is <strong>${item.maxWords} words</strong>). Shorten your answer! Model: <em>"${item.sampleAnswer}"</em>.`;
          return;
        }

        if (item.id === "ff_when" && lower.includes("years ago")) {
          mistakes.push("When?: repeated 'years ago'");
          fb.className = "text-xs p-2.5 rounded-xl mt-1 bg-red-100 text-red-950 font-medium";
          fb.innerHTML = `❌ The words <em>"years ago"</em> are already printed after the blank! Write only <strong>"about 11,000"</strong>.`;
          return;
        }

        if (item.id === "ff_crops" && lower.includes("wheat")) {
          mistakes.push("Crops: repeated 'wheat'");
          fb.className = "text-xs p-2.5 rounded-xl mt-1 bg-red-100 text-red-950 font-medium";
