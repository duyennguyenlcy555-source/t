    function collectAllFormInputs() {
      const inputs = {};
      document.querySelectorAll("#studentWorkbookView input[id], #studentWorkbookView select[id], #studentWorkbookView textarea[id]").forEach(el => {
        if (el.type === "file") return;
        inputs[el.id] = el.value;
      });
      document.querySelectorAll("#studentWorkbookView input[type='radio']:checked").forEach(r => {
        inputs[`radio_${r.name}`] = r.value;
      });
      return inputs;
    }

    function saveCurrentDraftState() {
      const rec = ensureCurrentStudentRecord();
      if (!rec.name || !rec.studentClass) return;
      rec.draftInputs = collectAllFormInputs();
      const noteEl = document.getElementById("studentSubmissionNote");
      if (noteEl) rec.submissionNote = noteEl.value;
      rec.lastActive = new Date().toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      saveStudentRecordEverywhere(rec);
    }

    function restoreSavedStudentWork() {
      const rec = ensureCurrentStudentRecord();
      if (!rec || !rec.name) return;

      document.querySelectorAll("#studentWorkbookView input[id], #studentWorkbookView select[id], #studentWorkbookView textarea[id]").forEach(el => {
        if (el.type !== "file") el.value = "";
      });
      document.querySelectorAll("#studentWorkbookView input[type='radio']").forEach(r => {
        r.checked = false;
      });

      const saved = rec.draftInputs || {};
      Object.entries(saved).forEach(([key, val]) => {
        if (key.startsWith("radio_")) {
          const rName = key.replace("radio_", "");
          const radio = document.querySelector(`input[name="${rName}"][value="${val}"]`);
          if (radio) radio.checked = true;
        } else {
          const el = document.getElementById(key);
          if (el && el.type !== "file") {
            el.value = val;
            if (typeof el.oninput === "function") {
              el.oninput();
            }
          }
        }
      });

      const noteEl = document.getElementById("studentSubmissionNote");
      if (noteEl) noteEl.value = rec.submissionNote || "";

      updateSubmissionUI();
      refreshGlobalProgress();
    }

