    function loadAllPersistedData() {
      try {
        // Scan all fcw_student_<class>_<name> keys in localStorage
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith("fcw_student_")) {
            const raw = localStorage.getItem(k);
            if (raw) {
              const rec = JSON.parse(raw);
              if (rec && rec.name && rec.studentClass) {
                const normKey = window.getStudentNormalizedKey(rec.studentClass, rec.name);
                window.appState.roster[normKey] = rec;
              }
            }
          }
        }
        const savedPosts = localStorage.getItem(POSTS_STORAGE_KEY);
        if (savedPosts) {
          const parsedPosts = JSON.parse(savedPosts);
          if (Array.isArray(parsedPosts)) {
            window.appState.peerPosts = parsedPosts;
          }
        }
        const savedSession = localStorage.getItem(SESSION_STORAGE_KEY);
        if (savedSession) {
          const parsedSession = JSON.parse(savedSession);
          if (parsedSession && parsedSession.name && parsedSession.studentClass) {
            window.appState.currentStudent = parsedSession;
          }
        }
      } catch (e) {
        console.warn("LocalStorage read error:", e);
      }
    }

    function saveStudentRecordEverywhere(rec) {
      if (!rec || !rec.name || !rec.studentClass) return;
      const normKey = window.getStudentNormalizedKey(rec.studentClass, rec.name);
      window.appState.roster[normKey] = rec;
      try {
        localStorage.setItem(normKey, JSON.stringify(rec));
        localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify({
          name: rec.name,
          studentClass: rec.studentClass,
          studentCode: rec.studentCode || ""
        }));
      } catch (e) {
        console.warn("LocalStorage write warning:", e);
      }
      const badge = document.getElementById("autoSaveBadge");
      if (badge) {
        badge.textContent = `Saved ✓ ${new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`;
      }
      if (typeof window.syncStudentRecordToCloud === "function") {
        window.syncStudentRecordToCloud(rec);
      }
    }

