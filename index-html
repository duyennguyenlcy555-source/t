    const SESSION_STORAGE_KEY = "fcw_active_session_v3";
    const POSTS_STORAGE_KEY = "fcw_peer_posts_all";

    window.getStudentNormalizedKey = function(studentClass, name) {
      const cleanClass = (studentClass || "").trim().toLowerCase().replace(/[^a-z0-9_-]/g, "_");
      const cleanName = (name || "").trim().toLowerCase().replace(/[^a-z0-9_-]/g, "_");
      return `fcw_student_${cleanClass}_${cleanName}`;
    };

    window.appState = {
      roleSelected: false,
      currentRole: "student",
      currentStudent: { name: "", studentClass: "", studentCode: "" },
      roster: {},
      peerPosts: []
    };
