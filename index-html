<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Farming Changes the World — Interactive Digital Workbook</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Fraunces', 'serif'],
          },
          colors: {
            parchment: '#FAF8F5',
            linen: '#F2EFE9',
            tealDeep: '#0F5C5C',
            tealDark: '#0A4242',
            tealSoft: '#E6F2F2',
            terracotta: '#D96B43',
            terracottaDark: '#B8522D',
            ink: '#1E293B',
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #FAF8F5;
      color: #1E293B;
    }
    .font-display { font-family: 'Fraunces', serif; }
    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: #F2EFE9; }
    ::-webkit-scrollbar-thumb { background: #C2BCB0; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #9E9687; }
    @keyframes recPulse {
      0% { transform: scale(0.96); box-shadow: 0 0 0 0 rgba(217, 107, 67, 0.65); }
      70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(217, 107, 67, 0); }
      100% { transform: scale(0.96); box-shadow: 0 0 0 0 rgba(217, 107, 67, 0); }
    }
    .recording-pulse { animation: recPulse 1.4s infinite; }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-teal-100 selection:text-tealDeep">

  <!-- Toast Notification Banner (No alert() used) -->
  <div id="toastBanner" class="fixed bottom-5 right-5 z-50 hidden max-w-sm bg-ink text-white px-4 py-3 rounded-2xl shadow-xl border border-slate-700 flex items-center gap-3 transition-all duration-300">
    <span id="toastIcon" class="text-lg">✨</span>
    <div class="text-sm font-medium" id="toastMsg">Progress saved!</div>
  </div>

  <!-- ==================== LANDING SCREEN: ARE YOU A TEACHER OR A STUDENT? ==================== -->
  <div id="roleWelcomeScreen" class="fixed inset-0 z-40 bg-parchment overflow-y-auto flex flex-col justify-between p-4 sm:p-8">
    <div class="max-w-4xl w-full mx-auto my-auto space-y-8">
      <!-- Unit Header -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-tealSoft text-tealDeep text-xs font-bold uppercase tracking-wider border border-teal-200">
          <span>🌾 History A1–A2 • Neolithic Period (New Stone Age)</span>
        </div>
        <h1 class="font-display text-3xl sm:text-5xl font-bold text-ink tracking-tight">Farming Changes the World</h1>
        <p class="text-base sm:text-lg font-semibold text-tealDeep">Are you a Teacher or a Student?</p>
        <p class="text-xs sm:text-sm text-stone-600 max-w-xl mx-auto">
          Select your role below to enter the interactive digital workbook and asynchronous classroom.
        </p>
      </div>

      <!-- Two Role Selection Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: I am a Student -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-stone-200 hover:border-tealDeep shadow-sm transition flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-tealSoft text-tealDeep flex items-center justify-center text-2xl font-bold">
              🎒
            </div>
            <h2 class="font-display text-2xl font-bold text-ink">I am a Student</h2>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Enter your Full Name and Class to complete all 5 learning stations at home with automatic progress saving, live word-count limits, instant diagnostic feedback, voice recording, and final assignment submission.
            </p>
            <div class="space-y-3 pt-2">
              <div>
                <label for="welcomeStudentName" class="block text-xs font-bold text-stone-700 mb-1">Full Name *</label>
                <input type="text" id="welcomeStudentName" placeholder="Enter your full name..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-tealDeep">
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label for="welcomeStudentClass" class="block text-xs font-bold text-stone-700 mb-1">Class *</label>
                  <input type="text" id="welcomeStudentClass" placeholder="e.g. 6A1" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-tealDeep">
                </div>
                <div>
                  <label for="welcomeStudentCode" class="block text-xs font-bold text-stone-700 mb-1">Student ID (Optional)</label>
                  <input type="text" id="welcomeStudentCode" placeholder="e.g. HS012" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-tealDeep">
                </div>
              </div>
            </div>
          </div>
          <button type="button" onclick="enterAsStudent()" class="w-full py-3.5 px-5 rounded-2xl bg-tealDeep hover:bg-tealDark text-white font-bold text-sm shadow-sm transition flex items-center justify-center gap-2">
            <span>Start / Resume Workbook</span>
            <span>→</span>
          </button>
        </div>

        <!-- Card 2: I am a Teacher -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-stone-200 hover:border-terracotta shadow-sm transition flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-orange-50 text-terracotta flex items-center justify-center text-2xl font-bold">
              👩‍🏫
            </div>
            <h2 class="font-display text-2xl font-bold text-ink">I am a Teacher</h2>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              Open the live Teacher Progress Dashboard to track who has completed each station from home, inspect every typed answer, diagnose word-limit and grammar errors, listen to voice posts, and export CSV/JSON reports.
            </p>
            <div class="p-3.5 rounded-2xl bg-linen/90 border border-stone-200 text-xs text-stone-700 space-y-1.5">
              <div class="font-bold text-ink">📡 Live Home-Study Tracking:</div>
              <ul class="list-disc pl-4 space-y-1 text-stone-600">
                <li>Zero sample profiles—only real student submissions appear.</li>
                <li>Filter progress by class and click <strong>Inspect Answers</strong> on any student row.</li>
                <li>Import student <strong>.json</strong> files or export class spreadsheets anytime.</li>
              </ul>
            </div>
          </div>
          <button type="button" onclick="enterAsTeacher()" class="w-full py-3.5 px-5 rounded-2xl bg-terracotta hover:bg-terracottaDark text-white font-bold text-sm shadow-sm transition flex items-center justify-center gap-2">
            <span>Open Teacher Progress Dashboard</span>
            <span>📊</span>
          </button>
        </div>
      </div>
    </div>

    <div class="text-center text-xs text-stone-500 pt-6">
      Classroom Sync Status: <span id="syncStatusIndicator" class="font-semibold text-tealDeep">Initializing live sync...</span>
    </div>
  </div>

  <!-- Top Navigation Bar -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-stone-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <!-- Unit Title -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-tealDeep text-white flex items-center justify-center font-display font-bold text-xl shadow-sm">
          🌾
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-tealSoft text-tealDeep">History A1–A2</span>
            <span class="text-xs text-stone-500 hidden sm:inline">Neolithic Period (New Stone Age)</span>
          </div>
          <h1 class="font-display text-lg sm:text-xl font-bold text-ink leading-tight">Farming Changes the World</h1>
        </div>
      </div>

      <!-- Student Identity Badge -->
      <div id="headerStudentBadge" class="flex flex-wrap items-center gap-2 bg-linen px-3 py-1.5 rounded-2xl border border-stone-200">
        <div class="w-7 h-7 rounded-full bg-tealDeep text-white text-xs font-bold flex items-center justify-center" id="studentAvatar">ST</div>
        <div class="flex items-center gap-1.5 text-xs">
          <label for="headerStudentName" class="sr-only">Student Full Name</label>
          <input id="headerStudentName" type="text" onchange="updateStudentIdentity()" placeholder="Full Name" class="w-28 sm:w-36 px-2 py-1 rounded-lg bg-white border border-stone-300 font-semibold text-ink focus:outline-none focus:ring-2 focus:ring-tealDeep" />
          <label for="headerStudentClass" class="sr-only">Class</label>
          <input id="headerStudentClass" type="text" onchange="updateStudentIdentity()" placeholder="Class" class="w-16 sm:w-20 px-2 py-1 rounded-lg bg-white border border-stone-300 font-medium text-stone-700 focus:outline-none focus:ring-2 focus:ring-tealDeep" />
        </div>
        <button type="button" onclick="openStudentProfileModal()" class="text-[11px] font-semibold text-terracotta hover:text-terracottaDark underline px-1">
          Edit
        </button>
      </div>

      <!-- Right Action Buttons -->
      <div class="flex items-center gap-2">
        <button type="button" onclick="showRoleWelcomeScreen()" class="px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-linen text-stone-700 hover:bg-stone-200 border border-stone-300 flex items-center gap-1.5 transition">
          <span>🔄</span>
          <span>Switch Role</span>
        </button>
        <button type="button" onclick="toggleReferenceDrawer()" id="btnToggleRef" class="px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-amber-50 text-amber-900 hover:bg-amber-100 border border-amber-300 flex items-center gap-1.5 transition">
          <span>📖</span>
          <span class="hidden md:inline">Reading &</span>
          <span>Glossary</span>
        </button>
        <button type="button" onclick="toggleAppView()" id="btnToggleMode" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-tealDeep text-white hover:bg-tealDark flex items-center gap-1.5 shadow-sm transition">
          <span id="modeToggleIcon">📊</span>
          <span id="modeToggleLabel">Teacher Dashboard</span>
        </button>
      </div>
    </div>

    <!-- Student Progress Sub-bar -->
    <div id="studentProgressSubbar" class="bg-linen/80 border-t border-stone-200/80 px-4 sm:px-6 py-2">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-3 flex-1">
          <span class="text-xs font-semibold text-stone-600 whitespace-nowrap">Your Progress:</span>
          <div class="w-full max-w-md bg-stone-200 h-2.5 rounded-full overflow-hidden">
            <div id="globalProgressBar" class="bg-tealDeep h-full rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <span id="globalProgressText" class="text-xs font-bold text-tealDeep whitespace-nowrap">0% (0/5 stations)</span>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-xs text-stone-600">
          <span>Score: <strong id="globalScoreText" class="text-terracotta text-sm">0/48</strong> pts</span>
          <span id="autoSaveBadge" class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold text-[11px]">Saved ✓</span>
          <button type="button" onclick="switchStation(6)" id="quickSubmitHeaderBtn" class="px-3 py-1 rounded-xl bg-terracotta hover:bg-terracottaDark text-white font-bold text-xs shadow-sm transition">
            📨 Submit Assignment
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ==================== VIEW 1: STUDENT WORKBOOK ==================== -->
  <div id="studentWorkbookView" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 flex flex-col lg:flex-row gap-6">

    <!-- Main Stations Column -->
    <main class="flex-1 min-w-0">

      <!-- 6 Station Navigation Tabs (Stations 1-5 + Final Submit) -->
      <nav aria-label="Learning Stations" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 mb-6">
        <button type="button" onclick="switchStation(1)" id="navStation1" class="station-tab text-left p-3 rounded-2xl border-2 transition flex flex-col justify-between bg-white border-tealDeep shadow-sm">
          <div class="flex items-center justify-between w-full mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-tealDeep">Station 1</span>
            <span id="badgeStation1" class="text-xs px-1.5 py-0.5 rounded-full bg-tealSoft text-tealDeep font-semibold">0/6</span>
          </div>
          <div class="text-xs sm:text-sm font-bold text-ink leading-snug">1. Farming Words</div>
        </button>

        <button type="button" onclick="switchStation(2)" id="navStation2" class="station-tab text-left p-3 rounded-2xl border-2 transition flex flex-col justify-between bg-white border-stone-200 hover:border-stone-300">
          <div class="flex items-center justify-between w-full mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Station 2</span>
            <span id="badgeStation2" class="text-xs px-1.5 py-0.5 rounded-full bg-stone-100 text-stone-600 font-semibold">0/6</span>
          </div>
          <div class="text-xs sm:text-sm font-bold text-ink leading-snug">3A. Fact File</div>
        </button>

        <button type="button" onclick="switchStation(3)" id="navStation3" class="station-tab text-left p-3 rounded-2xl border-2 transition flex flex-col justify-between bg-white border-stone-200 hover:border-stone-300">
          <div class="flex items-center justify-between w-full mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Station 3</span>
            <span id="badgeStation3" class="text-xs px-1.5 py-0.5 rounded-full bg-stone-100 text-stone-600 font-semibold">0/16</span>
          </div>
          <div class="text-xs sm:text-sm font-bold text-ink leading-snug">3B–D. Timeline & Map</div>
        </button>

        <button type="button" onclick="switchStation(4)" id="navStation4" class="station-tab text-left p-3 rounded-2xl border-2 transition flex flex-col justify-between bg-white border-stone-200 hover:border-stone-300">
          <div class="flex items-center justify-between w-full mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Station 4</span>
            <span id="badgeStation4" class="text-xs px-1.5 py-0.5 rounded-full bg-stone-100 text-stone-600 font-semibold">0/20</span>
          </div>
          <div class="text-xs sm:text-sm font-bold text-ink leading-snug">4–5A. Past Simple</div>
        </button>

        <button type="button" onclick="switchStation(5)" id="navStation5" class="station-tab text-left p-3 rounded-2xl border-2 transition flex flex-col justify-between bg-white border-stone-200 hover:border-stone-300">
          <div class="flex items-center justify-between w-full mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Station 5</span>
            <span id="badgeStation5" class="text-xs px-1.5 py-0.5 rounded-full bg-orange-100 text-terracottaDark font-semibold">Speak & Share</span>
          </div>
          <div class="text-xs sm:text-sm font-bold text-ink leading-snug">5B. Interview & Wall</div>
        </button>

        <button type="button" onclick="switchStation(6)" id="navStation6" class="station-tab text-left p-3 rounded-2xl border-2 transition flex flex-col justify-between bg-white border-stone-200 hover:border-terracotta">
          <div class="flex items-center justify-between w-full mb-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">Final Step</span>
            <span id="badgeStation6" class="text-xs px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-900 font-semibold">Draft</span>
          </div>
          <div class="text-xs sm:text-sm font-bold text-ink leading-snug">📨 Submit Work</div>
        </button>
      </nav>

      <!-- ==================== STATION 1: VOCABULARY MATCH ==================== -->
      <section id="station1" class="station-panel space-y-6">
        <div class="bg-white rounded-3xl p-5 sm:p-7 border border-stone-200 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3 border-b border-stone-100 pb-4 mb-5">
            <div>
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-tealDeep bg-tealSoft px-2.5 py-1 rounded-full mb-1">Part 1 • Vocabulary</span>
              <h2 class="font-display text-xl sm:text-2xl font-bold text-ink">1. Farming words — Match the words to the meanings</h2>
              <p class="text-sm text-stone-600 mt-1">Select the matching definition (<strong>a–f</strong>) for each keyword. Click <strong>Check Answers</strong> for immediate diagnostic feedback.</p>
            </div>
            <button type="button" onclick="openReferenceTab('glossary')" class="text-xs font-semibold px-3 py-2 rounded-xl bg-tealSoft text-tealDeep hover:bg-teal-100 transition">
              🔤 Open Bilingual Glossary
            </button>
          </div>

          <div id="vocabList" class="space-y-3.5">
            <!-- Rendered by JS -->
          </div>

          <div class="mt-6 pt-4 border-t border-stone-100 flex flex-wrap items-center justify-between gap-3">
            <div id="station1Summary" class="text-sm font-medium text-stone-600">Complete all 6 vocabulary items to check your understanding.</div>
            <div class="flex items-center gap-2">
              <button type="button" onclick="checkStation1()" class="px-5 py-2.5 rounded-xl bg-terracotta hover:bg-terracottaDark text-white font-semibold text-sm shadow-sm transition">
                ✓ Check Answers
              </button>
              <button type="button" onclick="switchStation(2)" class="px-4 py-2.5 rounded-xl bg-linen hover:bg-stone-200 text-ink font-semibold text-sm transition">
                Next: Fact File →
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== STATION 2: FACT FILE (3A) ==================== -->
      <section id="station2" class="station-panel hidden space-y-6">
        <div class="bg-white rounded-3xl p-5 sm:p-7 border border-stone-200 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3 border-b border-stone-100 pb-4 mb-5">
            <div>
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-tealDeep bg-tealSoft px-2.5 py-1 rounded-full mb-1">Part 3A • Check your understanding</span>
              <h2 class="font-display text-xl sm:text-2xl font-bold text-ink">Complete the fact file. Use information from Part A.</h2>
              <p class="text-sm text-stone-600 mt-1">Fill in each row using facts from <strong>Part A</strong> of the reading text. Watch the <strong>live word counter</strong>—it turns red if you exceed <em>max. words</em>!</p>
            </div>
            <button type="button" onclick="openReferenceTab('text')" class="text-xs font-semibold px-3 py-2 rounded-xl bg-amber-50 text-amber-900 border border-amber-200 hover:bg-amber-100 transition">
              📖 Read Part A
            </button>
          </div>

          <div class="overflow-hidden rounded-2xl border border-teal-200 shadow-sm">
            <div class="bg-tealSoft px-4 py-3 grid grid-cols-1 md:grid-cols-12 gap-2 font-bold text-tealDeep text-sm">
              <div class="md:col-span-4 flex items-center gap-2">
                <span>📋</span>
                <span>Fact file: the first farmers</span>
              </div>
              <div class="md:col-span-8">Your answers (Live Word-Count Enforcer)</div>
            </div>

            <div id="factFileRows" class="divide-y divide-stone-200 bg-white">
              <!-- Rendered by JS -->
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-stone-100 flex flex-wrap items-center justify-between gap-3">
            <div id="station2Summary" class="text-sm font-medium text-stone-600">Keep every answer concise and within the word limit.</div>
            <div class="flex items-center gap-2">
              <button type="button" onclick="checkStation2()" class="px-5 py-2.5 rounded-xl bg-terracotta hover:bg-terracottaDark text-white font-semibold text-sm shadow-sm transition">
                ✓ Check Fact File
              </button>
              <button type="button" onclick="switchStation(3)" class="px-4 py-2.5 rounded-xl bg-linen hover:bg-stone-200 text-ink font-semibold text-sm transition">
                Next: Timeline & Map →
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== STATION 3: TIMELINE, MIND MAP & HISTORIAN (3B, 3C, 3D) ==================== -->
      <section id="station3" class="station-panel hidden space-y-6">
        <!-- 3B Timeline -->
        <div class="bg-white rounded-3xl p-5 sm:p-7 border border-stone-200 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-tealDeep bg-tealSoft px-2.5 py-1 rounded-full">Part 3B • Timeline</span>
              <h3 class="font-display text-xl font-bold text-ink mt-1">B. Complete the timeline (max. 8 words per gap)</h3>
            </div>
            <button type="button" onclick="openReferenceTab('text')" class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-amber-50 text-amber-900 border border-amber-200">📖 Check Reading Text</button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" id="timelineContainer">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- 3C Mind Map -->
        <div class="bg-white rounded-3xl p-5 sm:p-7 border border-stone-200 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-tealDeep bg-tealSoft px-2.5 py-1 rounded-full">Part 3C • Mind Map (Parts B–E)</span>
          <h3 class="font-display text-xl font-bold text-ink mt-1 mb-1">C. How did farming change people's lives?</h3>
          <p class="text-sm text-stone-600 mb-4">Write 2 more ideas in each box using information from Parts B–E (<strong>max. 5 words each</strong>).</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="mindMapContainer">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- 3D Be a good historian -->
        <div class="bg-white rounded-3xl p-5 sm:p-7 border border-stone-200 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta bg-orange-50 px-2.5 py-1 rounded-full">Part 3D • Be a good historian</span>
          <h3 class="font-display text-xl font-bold text-ink mt-1 mb-1">D. Was farming a turning point? Complete the table.</h3>
          <p class="text-sm text-stone-600 mb-4">Compare life before and after farming (<strong>max. 5 words</strong> per cell) and complete the summary sentence (<strong>max. 15 words</strong>).</p>

          <div class="overflow-hidden rounded-2xl border border-stone-200 mb-4">
            <div class="grid grid-cols-2 bg-linen font-bold text-sm text-ink p-3">
              <div>⏪ Before farming, people...</div>
              <div>⏩ After farming, people...</div>
            </div>
            <div class="divide-y divide-stone-200 text-sm" id="historianTableContainer">
              <!-- Rendered by JS -->
            </div>
          </div>

          <div class="bg-linen/70 p-4 rounded-2xl border border-stone-200">
            <label for="turningPointInput" class="block text-sm font-bold text-ink mb-1">
