      if (students.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-10 px-4 text-center text-stone-500">
              <div class="text-2xl mb-1">📭</div>
              <div class="font-bold text-ink text-sm">No student submissions yet</div>
              <p class="text-xs max-w-md mx-auto mt-1">When students enter their Full Name & Class and submit their work at home (or when you click Import Student .json above), their scores and voice recordings appear here.</p>
            </td>
          </tr>
        `;
      } else {
        tbody.innerHTML = students.map((s, idx) => {
          const doneCount = [s.s1.done, s.s2.done, s.s3.done, s.s4.done, s.s5.done].filter(Boolean).length;
          const compPct = Math.round((doneCount / 5) * 100);
          const statusBadge = s.submitted
            ? `<span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold">Submitted ✅</span>`
            : doneCount > 0
              ? `<span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 text-[11px] font-bold">In Progress</span>`
              : `<span class="px-2.5 py-1 rounded-full bg-stone-100 text-stone-500 text-[11px] font-bold">Joined</span>`;

          const totalScore = s.s1.score + s.s2.score + s.s3.score + s.s4.score;
          const scorePct = Math.round((totalScore / 48) * 100);
          const wlErrors = (s.s2.wordLimitErrors || 0) + (s.s3.wordLimitErrors || 0);
          const allMistakes = [...(s.s1.mistakes || []), ...(s.s2.mistakes || []), ...(s.s3.mistakes || []), ...(s.s4.mistakes || [])];

          return `
            <tr class="hover:bg-linen/40">
              <td class="py-3 px-4 font-bold text-ink">
                ${s.name} <span class="text-xs font-normal text-stone-500">(${s.studentClass}${s.studentCode ? ` • ${s.studentCode}` : ""})</span>
                <div class="text-[11px] font-normal text-stone-400">${s.submitted && s.submittedAt ? `Submitted: ${s.submittedAt}` : `Active: ${s.lastActive || "Now"}`}</div>
              </td>
              <td class="py-3 px-3">${statusBadge}</td>
              <td class="py-3 px-3 font-bold text-tealDeep whitespace-nowrap">${compPct}% <span class="text-xs font-normal text-stone-500">(${doneCount}/5)</span></td>
              <td class="py-3 px-3 font-bold text-ink">${scorePct}% <span class="text-xs font-normal text-stone-500">(${totalScore}/48)</span></td>
              <td class="py-3 px-3">
                ${wlErrors > 0
                  ? `<span class="px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-bold text-xs">${wlErrors} over-limit</span>`
                  : `<span class="text-stone-400 text-xs">0</span>`}
              </td>
              <td class="py-3 px-3 text-xs max-w-xs">
                ${allMistakes.length === 0
                  ? `<span class="text-emerald-700 font-medium">${doneCount > 0 ? "✓ No errors recorded" : "—"}</span>`
                  : `<ul class="list-disc pl-4 text-red-700 space-y-0.5">${allMistakes.slice(0, 2).map(m => `<li>${m}</li>`).join("")}${allMistakes.length > 2 ? `<li class="text-stone-500">+${allMistakes.length - 2} more...</li>` : ""}</ul>`
                }
              </td>
              <td class="py-3 px-3 text-xs whitespace-nowrap">
                <span class="font-semibold text-tealDeep">${s.s5.posts || 0} voice/posts</span>, <span class="text-stone-600">${s.s5.replies || 0} replies</span>
              </td>
              <td class="py-3 px-4 text-right">
                <button type="button" onclick="openInspectModal(${idx})" class="px-3 py-1.5 rounded-xl bg-tealSoft hover:bg-teal-100 text-tealDeep text-xs font-bold transition">
                  Inspect Answers
                </button>
              </td>
            </tr>
          `;
        }).join("");
      }

      const allClassMistakes = students.flatMap(s => [...(s.s1.mistakes || []), ...(s.s2.mistakes || []), ...(s.s3.mistakes || []), ...(s.s4.mistakes || [])]);
      document.getElementById("classDiagnosticsList").innerHTML = allClassMistakes.length === 0
        ? `<div class="p-3.5 rounded-xl bg-linen/70 text-stone-600">No mistakes recorded yet. Once students submit answers, common class errors will appear here.</div>`
        : allClassMistakes.slice(0, 6).map(m => `
            <div class="p-3.5 rounded-xl bg-red-50/70 border border-red-200 text-red-900 flex items-start gap-2">
              <span>⚠️</span>
              <span>${m}</span>
            </div>
          `).join("");
    }

    function openInspectModal(idx) {
      const s = currentTeacherRenderedStudents[idx];
      if (!s) return;
      document.getElementById("inspectModalTitle").textContent = `${s.name} (${s.studentClass}) — ${s.submitted ? "Submitted ✅" : "In Progress"}`;
      const allMistakes = [...(s.s1.mistakes || []), ...(s.s2.mistakes || []), ...(s.s3.mistakes || []), ...(s.s4.mistakes || [])];
      const studentAudioPosts = window.appState.peerPosts.filter(p => p.author === s.name && p.studentClass === s.studentClass);

      document.getElementById("inspectModalBody").innerHTML = `
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <div class="p-3 rounded-xl bg-linen/70"><strong>Station 1:</strong> ${s.s1.score}/${s.s1.max}</div>
          <div class="p-3 rounded-xl bg-linen/70"><strong>Station 2:</strong> ${s.s2.score}/${s.s2.max}</div>
          <div class="p-3 rounded-xl bg-linen/70"><strong>Station 3:</strong> ${s.s3.score}/${s.s3.max}</div>
          <div class="p-3 rounded-xl bg-linen/70"><strong>Station 4:</strong> ${s.s4.score}/${s.s4.max}</div>
        </div>
        ${s.submissionNote ? `<div class="p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-950"><strong>Student Reflection Note:</strong> ${s.submissionNote}</div>` : ""}
        ${studentAudioPosts.length > 0 ? `
          <div class="space-y-2">
            <div class="font-bold text-terracotta text-sm">Spoken Interview & Peer Wall Submissions (${studentAudioPosts.length}):</div>
            ${studentAudioPosts.map(p => `
              <div class="p-3.5 rounded-xl bg-orange-50/70 border border-orange-200 space-y-2">
                <div class="text-ink">${p.text}</div>
                ${p.audioUrl ? `<audio src="${p.audioUrl}" controls class="h-9 w-full"></audio>` : `<button type="button" onclick="playTextToSpeechAudio('${p.author.replace(/'/g, "\\'")}', '${(p.simulatedSpeechText || p.text).replace(/'/g, "\\'")}')" class="px-3 py-1.5 rounded-lg bg-terracotta text-white font-bold">▶ Play Spoken Audio (TTS)</button>`}
              </div>
            `).join("")}
          </div>
        ` : `<div class="p-3 rounded-xl bg-stone-50 text-stone-500">No spoken interview recording posted to Station 5 yet.</div>`}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <div class="font-bold text-ink mb-1">Exact Typed Answers:</div>
            <pre class="bg-linen/70 p-3 rounded-xl text-[11px] overflow-x-auto whitespace-pre-wrap font-sans text-stone-700">${JSON.stringify({ Station1_Vocab: s.s1.responses, Station2_FactFile: s.s2.responses, Station3_TimelineMap: s.s3.responses, Station4_Grammar: s.s4.responses }, null, 2)}</pre>
          </div>
          <div>
            <div class="font-bold text-red-700 mb-1">All Flagged Mistakes (${allMistakes.length}):</div>
            ${allMistakes.length === 0
              ? `<p class="text-emerald-700">No mistakes flagged for this student.</p>`
              : `<ul class="list-disc pl-4 space-y-1 text-red-800">${allMistakes.map(m => `<li>${m}</li>`).join("")}</ul>`
            }
          </div>
        </div>
      `;
      document.getElementById("inspectStudentModal").classList.remove("hidden");
    }

    function closeInspectModal() {
      document.getElementById("inspectStudentModal").classList.add("hidden");
    }

    function exportReportCSV() {
      const students = Object.values(window.appState.roster).filter(s => s && s.name && s.studentClass);
      const headers = [
        "Student Name",
        "Class",
        "Student ID",
        "Submission Status",
        "Submitted At",
        "Stations Done (out of 5)",
        "Station 1 Vocab (6)",
        "Station 2 Fact File (6)",
        "Station 3 Timeline & Map (16)",
        "Station 4 Past Simple (20)",
        "Accuracy Score %",
        "Word-Limit Errors",
        "Voice Posts",
        "Peer Replies",
        "Specific Mistakes Made"
      ];
      const rows = students.map(s => {
        const done = [s.s1.done, s.s2.done, s.s3.done, s.s4.done, s.s5.done].filter(Boolean).length;
        const status = s.submitted ? "Submitted" : done > 0 ? "In Progress" : "Joined";
        const totalScore = s.s1.score + s.s2.score + s.s3.score + s.s4.score;
        const scorePct = Math.round((totalScore / 48) * 100);
        const wlErrors = (s.s2.wordLimitErrors || 0) + (s.s3.wordLimitErrors || 0);
        const mistakes = [...(s.s1.mistakes || []), ...(s.s2.mistakes || []), ...(s.s3.mistakes || []), ...(s.s4.mistakes || [])].join(" | ");
        return [
          `"${s.name}"`,
          `"${s.studentClass}"`,
          `"${s.studentCode || ""}"`,
          `"${status}"`,
          `"${s.submittedAt || ""}"`,
          done,
          `${s.s1.score}/${s.s1.max}`,
          `${s.s2.score}/${s.s2.max}`,
          `${s.s3.score}/${s.s3.max}`,
          `${s.s4.score}/${s.s4.max}`,
          `${scorePct}%`,
          wlErrors,
          s.s5.posts || 0,
          s.s5.replies || 0,
          `"${mistakes.replace(/"/g, "'")}"`
        ].join(",");
      });
      const csvContent = "\uFEFF" + [headers.join(","), ...rows].join("\n");
      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "Farming_Changes_The_World_Class_Report.csv";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("CSV progress report downloaded!", "📥");
    }

    function exportReportJSON() {
      const payload = {
        unit: "Farming changes the world (A1-A2)",
        exportedAt: new Date().toISOString(),
        students: Object.values(window.appState.roster).filter(s => s && s.name && s.studentClass),
        peerPosts: window.appState.peerPosts
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "Farming_Changes_The_World_Class_Report.json";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("JSON progress report downloaded!", "📥");
    }

    // -------------------- INITIALIZE APPLICATION --------------------
    window.addEventListener("DOMContentLoaded", () => {
      loadAllPersistedData();
      renderGlossary();
      renderStation1();
      renderStation2();
      renderStation3();
      renderStation4();

      document.getElementById("studentWorkbookView").addEventListener("input", () => saveCurrentDraftState());
      document.getElementById("studentWorkbookView").addEventListener("change", () => saveCurrentDraftState());

      renderPeerFeed();
      if (window.appState.currentStudent.name && window.appState.currentStudent.studentClass) {
        restoreSavedStudentWork();
      }
      refreshGlobalProgress();
      showRoleWelcomeScreen();
    });
  </script>
</body>
</html>
