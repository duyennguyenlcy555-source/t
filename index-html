    function checkStation1() {
      let score = 0;
      const mistakes = [];
      const responses = {};

      VOCAB_QUESTIONS.forEach(q => {
        const val = document.getElementById(`sel_${q.id}`).value;
        const fb = document.getElementById(`fb_${q.id}`);
        const card = document.getElementById(`card_${q.id}`);
        fb.classList.remove("hidden");
        responses[q.word] = val || "(blank)";

        if (val === q.answer) {
          score++;
          card.className = "p-4 rounded-2xl bg-emerald-50/70 border border-emerald-300 transition";
          fb.className = "mt-2.5 text-xs p-2.5 rounded-xl bg-emerald-100/80 text-emerald-950 font-medium";
          fb.innerHTML = `✅ ${q.explainCorrect}`;
        } else {
          mistakes.push(`${q.word}: selected '${val || "blank"}' (correct: '${q.answer}')`);
          card.className = "p-4 rounded-2xl bg-red-50/70 border border-red-300 transition";
          fb.className = "mt-2.5 text-xs p-2.5 rounded-xl bg-red-100/80 text-red-950 font-medium";
          fb.innerHTML = `❌ ${q.explainWrong}`;
        }
      });

      const rec = ensureCurrentStudentRecord();
      rec.s1 = { done: true, score, max: 6, mistakes, wordLimitErrors: 0, responses };
      rec.draftInputs = collectAllFormInputs();
      saveStudentRecordEverywhere(rec);
      refreshGlobalProgress();

      document.getElementById("station1Summary").innerHTML =
        `Station 1 Score: <strong class="text-terracotta">${score}/6 correct</strong>. ${score === 6 ? "Excellent work! You mastered all 6 keywords." : "Review the explanations above and try again."}`;
